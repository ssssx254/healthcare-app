{
  "name": "servicehub-healthcare",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --lan",
    "start:localhost": "expo start --localhost",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --lan --android",
    "ios": "expo start --lan --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web && node scripts/copy-web-icon-font.js",
    "deploy:web": "npm run export:web && firebase deploy --only hosting"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
