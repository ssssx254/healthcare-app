# Хөгжүүлэлт — `.env` болгон хуулж ашиглана (git-д оруулахгүй)
# Expo: `npx expo start --lan`

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Android эмулятор (PC дээр backend ажиллаж байхад):
# EXPO_PUBLIC_APP_ENV=android-emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Expo Go физик утас (PC-ийн LAN IPv4 — ipconfig):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
