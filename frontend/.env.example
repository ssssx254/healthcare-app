# Хуулж `.env` болгоно (git-д оруулахгүй):  cp .env.example .env
#
# ┌─────────────────────┬──────────────────────────┬─────────────────────────────┐
# │                     │ Expo Go (npm start)      │ Web (npm run deploy:web)    │
# ├─────────────────────┼──────────────────────────┼─────────────────────────────┤
# │ API                 │ Локал PC :4000           │ Render → Aiven              │
# │ Тохиргоо            │ .env (development)       │ .env.production             │
# └─────────────────────┴──────────────────────────┴─────────────────────────────┘

# === Expo Go — локал backend (default) ===
EXPO_PUBLIC_APP_ENV=development
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api

# === Expo Go — production API турших: npm run start:cloud ===

# Android эмулятор:
# EXPO_PUBLIC_APP_ENV=android-emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# === Web deploy — зөвхөн .env.production (export-web.js уншина) ===
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_URL=https://healthcare-app-8bwy.onrender.com/api
