{
  "name": "healthcare-api",
  "version": "1.0.0",
  "description": "REST API for healthcare app (Express + MySQL)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/run-migration.js",
    "db:migrate:deploy": "node scripts/migrate-deploy.js",
    "db:migrate:production": "node scripts/assert-production-db.js && node scripts/migrate-deploy.js",
    "db:migrate:lab-tests": "node scripts/run-migration.js sql/migrations/011_lab_tests.sql",
    "db:migrate:catchup": "node scripts/run-migrations-catchup.js",
    "db:migrate:catchup:safe": "node scripts/run-migrations-catchup.js",
    "db:schema": "node scripts/run-migration.js sql/schema.sql",
    "db:create-admin": "node scripts/create-admin.js",
    "db:approve-pending-providers": "node scripts/approve-pending-providers.js",
    "db:cleanup-local-catalog": "node scripts/cleanup-local-catalog.js",
    "db:cleanup-local-catalog:yes": "node scripts/cleanup-local-catalog.js --yes",
    "db:cleanup-local-users": "node scripts/cleanup-local-users.js",
    "db:cleanup-local-users:yes": "node scripts/cleanup-local-users.js --yes"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
