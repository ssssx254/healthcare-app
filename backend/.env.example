# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# MySQL — локал
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=healthcare_db
DB_CONNECTION_LIMIT=10

# Эсвэл cloud MySQL (Render/Railway/Aiven) — нэг мөр:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/healthcare_db
# Aiven (SSL заавал): ?ssl=true — backend автоматаар TLS идэвхжүүлнэ
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:14733/defaultdb?ssl=true

# Auth (JWT) — production-д урт санамсаргүй string
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# CORS — production-д Firebase + local dev (таслалаар)
# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com,http://localhost:8081
