# Server
PORT=4000
NODE_ENV=development

# MySQL (mysql2 pool)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=healthcare_db

# Optional: connection pool size
DB_CONNECTION_LIMIT=10

# Auth (JWT)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
